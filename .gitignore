
# Terraform working directory
.terraform/

# Terraform state files (may contain sensitive data)
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Variable files that may contain secrets
*.tfvars
*.tfvars.json
!example.tfvars

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration
.terraformrc
terraform.rc

# Saved Terraform plans
*.tfplan
tfplan

# Environment files
.env
.env.*

# macOS
.DS_Store
